{
  "name": "@segment/analytics-generic-utils",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/segmentio/analytics-next",
    "directory": "packages/generic-utils"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "!**/__tests__/**",
    "!*.tsbuildinfo",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "npx tsc -p tsconfig.build.json",
    "build:cjs": "npx tsc -p tsconfig.build.json --outDir ./dist/cjs --module commonjs"
  },
  "dependencies": {
    "tslib": "^2.4.1"
  },
  "devDependencies": {
    "typescript": "^4.9.0"
  }
}
